datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Transaction {
  id         Int      @id @default(autoincrement())
  title      String
  amount     Float
  type       String
  category   String
  payer      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  FK_id_user Int?
  user       User?    @relation(fields: [FK_id_user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([FK_id_user])
  @@map("transactions")
}

model User {
  id           Int           @id @default(autoincrement())
  customer     String
  email        String        @unique
  pass         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  status       String        @default("active")
  transactions Transaction[]

  @@index([email])
  @@map("users")
}
